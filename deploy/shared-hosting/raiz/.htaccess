# Solution BPO — .htaccess da RAIZ (modo "raiz": projeto inteiro na pasta pública)

Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    # Alguns provedores exigem RewriteBase. Se o site der erro 500/404, descomente:
    # RewriteBase /

    # Bloqueia as pastas internas do Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules|deploy|docs|lang)(/|$) - [F,L]

    # Bloqueia arquivos ocultos (.env, .git, .htaccess...), exceto .well-known
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Bloqueia arquivos de projeto na raiz
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|phpunit\.xml|README\.md)$ - [F,L]

    # Produção: forçar HTTPS e www (descomente SOMENTE após a publicação autorizada)
    # RewriteCond %{HTTPS} off [OR]
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.solutionbpo.com.br%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Segunda camada: arquivos sensíveis, mesmo sem mod_rewrite
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|vite\.config\.js|phpunit\.xml|.*\.(log|sql|sh|bak|md|yml|yaml))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

AddType image/webp .webp
AddType font/woff2 .woff2
